---
import type { MenuRoute } from "@/interfaces";

interface Props {
  data: MenuRoute;
}

const { data } = Astro.props;

const { description, Icon, path, title } = data;
---

<section
  class="cursor-pointer bg-neutral-800 border border-neutral-700 rounded-lg shadow transition-all duration-300 hover:bg-neutral-700 hover:scale-105"
>
  <a href={path} class="flex flex-col p-6">
    <div class="flex gap-4 items-center mb-6">
      <Icon
        className="w-7 h-7 text-neutral-400 mb-3"
        aria-hidden="true"
      />
      <h5
        class="mb-2 text-2xl font-semibold tracking-tight text-neutral-100"
      >
        {title}
      </h5>
    </div>
    <div class="flex gap-6 items-center justify-start">
      <p class="font-normal text-neutral-400">
        {description}
      </p>
    </div>
  </a>
</section>
