<footer class="p-6 w-full text-slate-50 bg-neutral-900 fade-up">
  <div class="flex flex-col justify-center items-center gap-6">
    <div class="text-center md:text-left">
      <h2 class="text-2xl font-light text-slate-100 mb-2">React - GPT</h2>
      <p class="text-sm font-normal text-slate-100">
        A simple React app that uses the GPT API to generate text.
      </p>
    </div>

    <nav class="flex space-x-4 text-sm font-normal text-slate-100">
      <a href="https://github.com/CastDev-j" class="hover:underline">About</a>
      <a href="https://castdev-j.netlify.app/" class="hover:underline"
        >My Portfolio</a
      >
      <a href="mailto:andres2004_cj@outlook.com" class="hover:underline"
        >Contact</a
      >
    </nav>
  </div>

  <hr class="border-t border-slate-100 my-6" />

  <div class="flex justify-center">
    <div class="flex items-center space-x-4">
      <span
        class="block w-6 h-6 bg-slate-100 rounded-full animate-pulse"
        aria-hidden="true"></span>
      <p class="text-slate-100 font-normal texto-gen" aria-live="polite"></p>
    </div>
  </div>

  <hr class="border-t border-slate-100 my-6" />

  <script>
    document.addEventListener("astro:page-load", () => {
      newFunction();

      function newFunction() {
        const statusText = document.querySelector(".texto-gen") as HTMLElement;
        const phrases = [
          "Generating text with GPT...",
          "Fetching data from API...",
          "React and GPT integration...",
          "AI-powered text generation...",
        ];
        let index = 0;
        let isDeleting = false;
        let phraseIndex = 0;

        function typeEffect() {
          const currentPhrase = phrases[phraseIndex];
          if (!isDeleting && index < currentPhrase.length) {
            statusText.textContent =
              currentPhrase.substring(0, index + 1) + "|";
            index++;
            setTimeout(typeEffect, 100);
          } else if (isDeleting && index > 0) {
            statusText.textContent =
              currentPhrase.substring(0, index - 1) + "|";
            index--;
            setTimeout(typeEffect, 100);
          } else {
            isDeleting = !isDeleting;
            if (!isDeleting) {
              phraseIndex = (phraseIndex + 1) % phrases.length;
            }
            setTimeout(typeEffect, 1000);
          }
        }

        typeEffect();
      }
    });
  </script>
</footer>
