---
import { menuRoutes } from "@/store/routes";
import RouteLiComponent from "./RouteLiComponent.astro";
import {WelcomeInManyLanguajes} from "@/components/WelcomeInManyLanguajes";
---

<article class="flex flex-row gap-6 text-neutral-100">
  <nav
    class="hidden sm:flex flex-col w-[370px] min-h-[calc(100vh-3.0rem)] bg-neutral-800 p-5 rounded-3xl shadow-lg"
  >
    <div class="p-2">
      <h1 class="font-bold text-lg lg:text-3xl text-white">
        ReactGPT<span class="text-indigo-500">.</span>
      </h1>
      <span class="text-xl text-neutral-300">
        _<WelcomeInManyLanguajes client:load/>
      </span>
    </div>

    <div class="border-neutral-600 border my-3"></div>

    <ul
      class="flex flex-col gap-2 overflow-y-auto scrollbar-thin scrollbar-thumb-neutral-500 scrollbar-track-neutral-900"
    >
      {menuRoutes.map((route) => <RouteLiComponent data={route} />)}
    </ul>
  </nav>

  <section
    class="flex flex-col w-full h-[calc(100vh-50px)] bg-neutral-800 p-4 rounded-3xl shadow-lg"
  >
    <div class="flex flex-row h-full">
      <div class="flex flex-col flex-auto h-full">
        <slot />
      </div>
    </div>
  </section>
</article>
