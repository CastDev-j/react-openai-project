---
import Layout from "@/layouts/Layout.astro";
import { menuRoutes } from "@/store/routes";
import RouteCardComponent from "@/components/shared/RouteCardComponent.astro";
---

<Layout title="React - GPT | Inicio">
  <h1 class="text-xl font-normal text-neutral-100">
    Elige una funcionalidad de IA para usar
  </h1>

  <hr class="w-full h-1 bg-primary-500 my-1" />

  <article
    class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 justify-center items-center"
  >
    {menuRoutes.map((route) => <RouteCardComponent data={route} />)}
  </article>
</Layout>
