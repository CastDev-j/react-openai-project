---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="React - GPT">
  <div class="mx-auto max-w-screen-sm text-center text-neutral-100 min-h-[calc(100vh-40vh)] flex flex-col justify-center items-center fadeUp">
    <h1 class="text-6xl mb-8">404</h1>
    <p
      class="mb-4 text-3xl tracking-tight font-bold text-neutral-200 md:text-4xl"
    >
      Something's missing.
    </p>
    <p class="mb-4 text-lg font-light text-neutral-400">
      Sorry, we can't find that page. You'll find lots to explore on the home
      page.
    </p>
    <a
      href="/"
      class="inline-flex text-neutral-900 bg-neutral-300 hover:bg-neutral-400 focus:ring-4 focus:outline-none focus:ring-neutral-400 font-medium rounded-lg text-sm px-5 py-2.5 text-center my-4 transition-all"
    >
      Back to Homepage
    </a>
  </div>
</Layout>
