---
import "@/styles/global.css";
import Header from "@/components/shared/Header.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="flex flex-col gap-3 justify-center items-center bg-neutral-900">
    <Header title="React - GPT" />
    <main class="flex flex-col gap-4 fade-up min-h-full w-full p-6">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  body {
    scroll-behavior: smooth;
  }

  h1 {
    @apply text-3xl font-bold mb-4;
  }

  p {
    @apply mb-4;
  }

  ul {
    @apply list-disc list-inside;
  }

  strong {
    @apply font-bold text-neutral-300 text-2xl mt-2;
  }

  em {
    @apply italic text-pink-500;
  }
</style>
